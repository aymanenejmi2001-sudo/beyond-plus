[
  {
    "name": "theme_info",
    "theme_name": "BEYOND PLUS",
    "theme_version": "1.0.0",
    "theme_author": "BEYOND PLUS",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Laisser vide pour afficher le nom de la boutique en texte."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 5,
        "unit": "px",
        "label": "Largeur du logo",
        "default": 110
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px"
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_2",
        "label": "Fond secondaire",
        "info": "Emplacements d'images, bandeau du bas de page.",
        "default": "#F5F5F5"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Texte",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_foreground_2",
        "label": "Texte secondaire",
        "default": "#707070"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Filets",
        "default": "#E6E6E6"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Promotions",
        "info": "Lien « Sale » du menu, pourcentage de remise.",
        "default": "#D01616"
      }
    ]
  },
  {
    "name": "Mode sombre",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_scheme_toggle",
        "label": "Afficher le bouton « Mode sombre » dans l'en-tête",
        "default": true
      }
    ]
  },
  {
    "name": "Cartes produit",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Afficher la marque",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Afficher la deuxième image au survol",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Afficher les pastilles de couleur",
        "default": true
      },
      {
        "type": "text",
        "id": "option_name_size",
        "label": "Nom de l'option taille",
        "info": "Noms séparés par des virgules, tels qu'ils apparaissent sur vos produits.",
        "default": "Taille, Size"
      },
      {
        "type": "text",
        "id": "option_name_color",
        "label": "Nom de l'option couleur",
        "default": "Couleur, Color, Colour"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          {
            "value": "drawer",
            "label": "Tiroir latéral"
          },
          {
            "value": "page",
            "label": "Page panier"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Mention sous le sous-total",
        "default": "Frais de port et taxes calculés au paiement."
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_reveal",
        "label": "Révéler les sections au défilement",
        "default": true
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/beyondplus"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      }
    ]
  }
]
