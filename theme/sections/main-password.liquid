<div class="password">
  <p class="password__brand">{{ shop.name }}</p>
  <h1 class="display-2">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="prose muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'password__form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success">{{ 'sections.newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__form"><input type="email" name="contact[email]" placeholder="{{ 'sections.newsletter.email' | t }}" aria-label="{{ 'sections.newsletter.email' | t }}" required><button type="submit" class="newsletter__submit" aria-label="{{ 'sections.newsletter.submit' | t }}">{%- render 'icon', name: 'arrow-submit' -%}</button></div>
    {%- endif -%}
  {%- endform -%}
  <details class="password__login">
    <summary class="link-underline">{{ 'general.password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input type="password" name="password" class="field__input" placeholder="{{ 'customer.fields.password' | t }}" aria-label="{{ 'customer.fields.password' | t }}" autocomplete="current-password">
      <button type="submit" class="button button--primary">{% assign l = 'general.password.submit' | t %}{% render 'button-label', text: l %}</button>
    {%- endform -%}
  </details>
</div>

{% stylesheet %}
.password { min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3.2rem; padding: 4rem 2rem; text-align: center; }
.password__brand { font-family: var(--font-display); font-size: 1.8rem; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; }
.password__form { display: flex; flex-direction: column; align-items: center; gap: 1.6rem; width: min(48rem, 100%); margin-top: 1.6rem; }
.newsletter__form { display: flex; width: 100%; align-items: center; gap: 1.6rem; border-bottom: 0.1rem solid rgb(var(--c-fg)); }
.newsletter__form input { flex: 1; min-width: 0; padding: 1.6rem 0; background: none; border: none; outline: none; }
.newsletter__submit { display: grid; place-items: center; width: 4.4rem; height: 4.4rem; background: none; border: none; cursor: pointer; }
.password__login summary { cursor: pointer; list-style: none; font-size: var(--text-body-sm); }
{% endstylesheet %}

{% schema %}
{ "name": "Page mot de passe", "settings": [ { "type": "text", "id": "heading", "label": "Titre", "default": "Bientôt" } ] }
{% endschema %}
