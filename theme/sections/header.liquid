{%- liquid
  assign menu = linklists[section.settings.menu]
  assign highlight = section.settings.highlight_title | downcase | strip
-%}
<sticky-header class="header-wrapper" data-hidden="false">
  <header class="header">
    <div class="header__left">
      <button type="button" class="header__burger" data-open-drawer="MobileNav" aria-label="{{ 'sections.header.menu' | t }}">
        {%- render 'icon', name: 'menu', size: 18 -%}
      </button>

      <nav class="header__nav" aria-label="{{ 'sections.header.main_nav' | t }}">
        <ul class="header__nav-list">
          {%- for link in menu.links -%}
            {%- liquid
              assign title_dc = link.title | downcase | strip
              assign kind = 'link'
              if link.links.size > 0
                assign kind = 'dropdown'
                for child in link.links
                  if child.links.size > 0
                    assign kind = 'mega'
                  endif
                endfor
              endif
            -%}
            <li class="header__nav-item header__nav-item--{{ kind }}" data-menu-item>
              <a href="{{ link.url }}" class="header__nav-link"{% if kind != 'link' %} aria-haspopup="true" aria-expanded="false"{% endif %}>
                <span class="header__nav-label"{% if highlight != blank and title_dc == highlight %} data-sale{% endif %}>{{ link.title }}</span>
              </a>
              {%- if kind == 'dropdown' -%}
                <div class="header__dropdown" data-menu-panel>
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="header__panel-link">{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              {%- elsif kind == 'mega' -%}
                <div class="header__mega" data-menu-panel>
                  <div class="header__mega-inner">
                    <div class="header__mega-columns">
                      {%- for child in link.links -%}
                        <div>
                          <p class="header__mega-title">{{ child.title }}</p>
                          <div class="header__mega-list">
                            {%- if child.links.size > 0 -%}
                              {%- for grandchild in child.links -%}
                                <a href="{{ grandchild.url }}" class="header__panel-link link-line">{{ grandchild.title }}</a>
                              {%- endfor -%}
                            {%- else -%}
                              <a href="{{ child.url }}" class="header__panel-link link-line">{{ child.title }}</a>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                    <div class="header__mega-cards">
                      {%- for block in section.blocks -%}
                        {%- assign block_menu = block.settings.menu_item | downcase | strip -%}
                        {%- if block_menu == title_dc -%}
                          <a href="{{ block.settings.link | default: link.url }}" class="header__mega-card" {{ block.shopify_attributes }}>
                            <div class="header__mega-card-media media">
                              {%- render 'media-image', image: block.settings.image, fallback: 'beyond-1.jpg', sizes: '170px', alt: block.settings.heading -%}
                            </div>
                            <p class="header__mega-card-title">{{ block.settings.heading }}</p>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="header__brand" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: class: 'header__logo', style: 'width: var(--logo-width); height: auto;', alt: shop.name, widths: '120, 240, 480' }}
      {%- else -%}
        <span class="header__brand-symbol"><img src="{{ 'beyond-symbol.png' | asset_url }}" alt="" width="90" height="90"></span><span class="header__brand-mark">BEYOND PLUS</span>
      {%- endif -%}
    </a>

    <div class="header__right">
      {%- if settings.show_scheme_toggle -%}
        <button type="button" class="header__scheme" data-scheme-toggle aria-pressed="false">
          {{ 'sections.header.dark_mode' | t }}
          <span class="header__switch" aria-hidden="true"></span>
        </button>
      {%- endif -%}

      {%- if section.settings.locale_title != blank -%}
        <div class="header__locale" data-locale>
          <button type="button" class="header__action" aria-expanded="false">{{ section.settings.locale_label }}</button>
          <div class="header__locale-panel">
            <p class="header__locale-row"><span>{{ section.settings.locale_title }}</span><span class="muted">{{ cart.currency.iso_code }}</span></p>
            <p class="header__locale-note">{{ section.settings.locale_note }}</p>
          </div>
        </div>
      {%- endif -%}

      <button type="button" class="header__action" data-open-drawer="Search">{{ 'sections.header.search' | t }}</button>
      <button type="button" class="header__action-mobile icon-button" data-open-drawer="Search" aria-label="{{ 'sections.header.search' | t }}">{%- render 'icon', name: 'search' -%}</button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action">{{ 'sections.header.account' | t }}</a>
      {%- endif -%}

      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="header__cta">
          <span class="header__cta-clip"><span class="header__cta-label" data-label="{{ section.settings.cta_label | escape }}">{{ section.settings.cta_label }}</span></span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__cart" data-open-cart aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
        <span class="header__cart-label">{{ 'sections.header.cart' | t }}</span>
        {%- render 'icon', name: 'cart' -%}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </header>
</sticky-header>
<div class="header__scrim" data-menu-scrim aria-hidden="true"></div>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<div class="overlay" data-drawer-overlay="MobileNav"></div>
<nav class="mobile-nav" id="MobileNav" data-drawer aria-label="{{ 'sections.header.main_nav' | t }}" inert>
  <div class="mobile-nav__top">
    <span class="mobile-nav__brand">{{ shop.name }}</span>
    <button type="button" class="icon-button" data-close-drawer aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close', size: 18 -%}</button>
  </div>
  <div class="mobile-nav__body">
    <div class="mobile-nav__level" data-level="root">
      {%- for link in menu.links -%}
        {%- assign title_dc = link.title | downcase | strip -%}
        {%- if link.links.size > 0 -%}
          <button type="button" class="mobile-nav__row" data-open-level="MobileNav-{{ forloop.index }}">{{ link.title }}{%- render 'icon', name: 'arrow-right', size: 14 -%}</button>
        {%- else -%}
          <a href="{{ link.url }}" class="mobile-nav__row"{% if highlight != blank and title_dc == highlight %} data-sale{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <div class="mobile-nav__level" id="MobileNav-{{ forloop.index }}" data-level="sub" data-state="ahead">
          <button type="button" class="mobile-nav__back" data-close-level>{%- render 'icon', name: 'arrow-left', size: 12 -%}{{ link.title }}</button>
          <a href="{{ link.url }}" class="mobile-nav__sub">{{ 'sections.header.view_all' | t }}</a>
          {%- for child in link.links -%}
            {%- if child.links.size > 0 -%}
              <div class="mobile-nav__group">
                <p class="mobile-nav__group-title">{{ child.title }}</p>
                {%- for grandchild in child.links -%}<a href="{{ grandchild.url }}" class="mobile-nav__sub">{{ grandchild.title }}</a>{%- endfor -%}
              </div>
            {%- else -%}
              <a href="{{ child.url }}" class="mobile-nav__sub">{{ child.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="mobile-nav__footer">
    {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">{{ 'sections.header.account' | t }}</a>{%- endif -%}
    {%- if section.settings.cta_link != blank -%}<a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    <span class="muted">{{ section.settings.locale_label }}</span>
  </div>
</nav>

{%- comment -%} Search drawer (predictive search) {%- endcomment -%}
<div class="overlay" data-drawer-overlay="Search"></div>
<div class="search-panel" id="Search" data-drawer role="dialog" aria-modal="true" aria-label="{{ 'sections.header.search' | t }}" inert>
  <div class="search-panel__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__head">
      <label class="search-panel__field">
        <span class="visually-hidden">{{ 'sections.search.placeholder' | t }}</span>
        {%- render 'icon', name: 'search', size: 18 -%}
        <input type="search" name="q" placeholder="{{ 'sections.search.placeholder' | t }}" autocomplete="off" data-predictive-input>
        <input type="hidden" name="type" value="product">
      </label>
      <button type="button" class="icon-button" data-close-drawer aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close', size: 20 -%}</button>
    </form>
    <p class="search-panel__hint">{{ 'sections.search.hint' | t }}</p>
    <div class="search-panel__results" data-predictive-results aria-live="polite"></div>
  </div>
</div>

{% stylesheet %}
.header-wrapper { position: sticky; top: 0; z-index: var(--z-header); display: block; padding: 1rem 1.2rem; transition: transform 0.85s var(--ease-in-out-quint); }
.header-wrapper[data-hidden="true"] { transform: translate3d(0, calc(-100% - 3rem), 0); }
.header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.8rem; height: var(--header-inner-height); padding-inline: 0.4rem; background-color: rgb(var(--c-bg)); border: 0.1rem solid rgb(var(--c-border)); border-radius: 0.2rem; }
.header__left { display: flex; align-items: center; min-width: 0; }
.header__right { display: flex; align-items: center; justify-content: flex-end; }
.header__brand { display: flex; align-items: center; justify-content: center; padding-inline: 1.2rem; }
.header__brand-mark { font-family: var(--font-display); font-size: 1.8rem; font-weight: 500; line-height: 1; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap; }
.header__nav { display: none; }
@media (min-width: 1160px) { .header__nav { display: block; } }
.header__nav-list { display: flex; align-items: center; }
.header__nav-item--dropdown { position: relative; }
.header__nav-link { display: flex; align-items: center; height: 4.6rem; padding-inline: 0.8rem; }
.header__nav-label { display: block; font-size: var(--text-label); font-weight: 500; line-height: 1.5; text-transform: uppercase; transition: opacity var(--dur-default); }
.header__nav-item:hover .header__nav-label { opacity: var(--hover-opacity); }
.header__nav-label[data-sale] { color: rgb(var(--c-sale)); }
.header__action { display: none; align-items: center; height: 4.6rem; padding-inline: 0.8rem; background: none; border: none; cursor: pointer; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; transition: opacity var(--dur-default); }
.header__action:hover { opacity: var(--hover-opacity); }
@media (min-width: 990px) { .header__action { display: flex; } .header__action-mobile { display: none; } }
.header__locale { position: relative; display: none; }
@media (min-width: 990px) { .header__locale { display: flex; } }
.header__locale-panel { position: absolute; top: calc(100% + 0.8rem); right: 0; z-index: 5; min-width: 22rem; padding: 1.6rem; background-color: rgb(var(--c-bg)); border: 0.1rem solid rgb(var(--c-border)); opacity: 0; visibility: hidden; transition: opacity 0.25s, visibility 0.25s; }
.header__locale[data-open="true"] .header__locale-panel { opacity: 1; visibility: visible; }
.header__locale-row { display: flex; justify-content: space-between; gap: 1.2rem; font-size: var(--text-body-sm); font-weight: 500; }
.header__locale-note { margin-top: 0.8rem; font-size: var(--text-body-xs); line-height: var(--leading-prose); color: rgb(var(--c-fg-2)); }
.header__cta { display: none; align-items: center; height: 3.2rem; margin-inline: 0.8rem; padding: 0.6rem 1.2rem; border: 0.1rem solid rgb(var(--c-fg)); border-radius: var(--radius-button); font-size: var(--text-label); font-weight: 500; text-transform: uppercase; }
@media (min-width: 1160px) { .header__cta { display: inline-flex; } }
.header__cta-clip { display: block; overflow: hidden; }
.header__cta-label { position: relative; display: block; transition: var(--transition-label); }
.header__cta-label::after { content: attr(data-label); position: absolute; inset: 100% auto auto 0; }
@media (hover: hover) and (pointer: fine) { .header__cta:hover .header__cta-label { transform: translate3d(0, -100%, 0); } }
.header__cart { display: flex; align-items: center; gap: 0.8rem; height: 4.6rem; padding-inline: 0.8rem; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; transition: opacity var(--dur-default); }
.header__cart:hover { opacity: var(--hover-opacity); }
.header__cart-label { display: none; }
@media (min-width: 750px) { .header__cart-label { display: block; } .header__cart .icon--cart { display: none; } }
.header__cart-count { display: grid; place-items: center; min-width: 1.8rem; height: 1.8rem; padding-inline: 0.4rem; background-color: rgb(var(--c-fg)); color: rgb(var(--c-bg)); font-size: 1.1rem; line-height: 1; }
.header__burger { display: flex; align-items: center; height: 4.6rem; padding-inline: 0.8rem; background: none; border: none; cursor: pointer; }
@media (min-width: 1160px) { .header__burger { display: none; } }
.header__scheme { display: none; align-items: center; gap: 0.8rem; height: 4.6rem; padding-inline: 0.8rem; background: none; border: none; cursor: pointer; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; }
@media (min-width: 1360px) { .header__scheme { display: flex; } }
.header__switch { position: relative; width: 2.4rem; height: 1.4rem; border-radius: 1rem; background-color: rgb(var(--c-interface)); }
.header__switch::after { content: ""; position: absolute; top: 0.2rem; left: 0.2rem; width: 1rem; height: 1rem; border-radius: 50%; background-color: rgb(var(--c-fg)); transition: transform var(--dur-default); }
.header__scheme[aria-pressed="true"] .header__switch::after { transform: translateX(1rem); }
.header__mega { position: absolute; top: 5.8rem; left: 1.2rem; right: 1.2rem; z-index: calc(var(--z-header) - 1); background-color: rgb(var(--c-bg)); border: 0.1rem solid rgb(var(--c-border)); opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }
.header__mega-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 34rem); gap: 3.2rem; padding: 2.4rem; }
.header__mega-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2.4rem 1.6rem; align-content: start; }
.header__mega-title { margin-bottom: 1.2rem; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; color: rgb(var(--c-fg-2)); }
.header__mega-list { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
.header__panel-link { display: inline-block; font-size: var(--text-body); line-height: 1.4; transition: opacity var(--dur-default); }
.header__panel-link:hover { opacity: var(--hover-opacity); }
.header__mega-cards { display: grid; grid-auto-flow: column; gap: 1.2rem; }
.header__mega-card-media { aspect-ratio: 4 / 5; }
.header__mega-card-title { margin-top: 0.8rem; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; }
.header__dropdown { position: absolute; top: 100%; left: 0; min-width: 20rem; padding: 1.2rem 1.6rem; display: flex; flex-direction: column; gap: 0.6rem; background-color: rgb(var(--c-bg)); border: 0.1rem solid rgb(var(--c-border)); opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }
.header__nav-item[data-open="true"] > [data-menu-panel] { opacity: 1; visibility: visible; }
.header__scrim { position: fixed; inset: 0; z-index: calc(var(--z-header) - 2); background-color: rgba(0, 0, 0, 0.25); opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }
.header__scrim[data-open="true"] { opacity: 1; visibility: visible; }

.mobile-nav { position: fixed; inset: 0 auto 0 0; z-index: calc(var(--z-drawer) + 1); width: min(42rem, 100vw); display: flex; flex-direction: column; background-color: rgb(var(--c-bg)); transform: translate3d(-100%, 0, 0); visibility: hidden; transition: transform 0.4s var(--ease-in-out-quint), visibility 0.4s; }
.mobile-nav[data-open="true"] { transform: none; visibility: visible; }
.mobile-nav__top { display: flex; align-items: center; justify-content: space-between; height: 5.6rem; padding-inline: 2rem; border-bottom: 0.1rem solid rgb(var(--c-border)); flex-shrink: 0; }
.mobile-nav__brand { font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; }
.mobile-nav__body { position: relative; flex: 1; overflow: hidden; }
.mobile-nav__level { position: absolute; inset: 0; overflow-y: auto; padding: 1.6rem 0 3.2rem; background-color: rgb(var(--c-bg)); transition: transform 0.4s var(--ease-in-out-quint); }
.mobile-nav__level[data-state="behind"] { transform: translate3d(-24%, 0, 0); }
.mobile-nav__level[data-state="ahead"] { transform: translate3d(100%, 0, 0); }
.mobile-nav__row { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; width: 100%; padding: 1.4rem 2rem; background: none; border: none; cursor: pointer; text-align: left; font-family: var(--font-display); font-size: 2.4rem; font-weight: 500; line-height: 1.05; letter-spacing: var(--display-tracking); text-transform: uppercase; }
.mobile-nav__row svg { opacity: 0.5; }
.mobile-nav__row[data-sale] { color: rgb(var(--c-sale)); }
.mobile-nav__back { display: flex; align-items: center; gap: 0.8rem; width: 100%; padding: 1.2rem 2rem 1.6rem; background: none; border: none; cursor: pointer; font-size: var(--text-label); font-weight: 500; text-transform: uppercase; color: rgb(var(--c-fg-2)); }
.mobile-nav__sub { display: block; padding: 1rem 2rem; font-size: var(--text-body); }
.mobile-nav__group { margin-top: 1.6rem; }
.mobile-nav__group-title { padding: 0 2rem 0.4rem; font-size: var(--text-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: rgb(var(--c-fg-2)); }
.mobile-nav__footer { flex-shrink: 0; display: flex; flex-wrap: wrap; gap: 1.2rem 2rem; padding: 1.6rem 2rem calc(1.6rem + env(safe-area-inset-bottom)); border-top: 0.1rem solid rgb(var(--c-border)); font-size: var(--text-label); font-weight: 500; text-transform: uppercase; }

.search-panel { position: fixed; top: 0; left: 0; right: 0; z-index: calc(var(--z-drawer) + 1); max-height: 100svh; overflow-y: auto; background-color: rgb(var(--c-bg)); transform: translate3d(0, -100%, 0); visibility: hidden; transition: transform 0.4s var(--ease-in-out-quint), visibility 0.4s; }
.search-panel[data-open="true"] { transform: none; visibility: visible; }
.search-panel__inner { max-width: 84rem; margin-inline: auto; padding: 2.4rem var(--gutter-editorial) 4rem; }
.search-panel__head { display: flex; align-items: center; gap: 1.6rem; padding-bottom: 1.6rem; border-bottom: 0.1rem solid rgb(var(--c-border)); }
.search-panel__field { position: relative; flex: 1; display: flex; align-items: center; }
.search-panel__field svg { position: absolute; left: 0; opacity: 0.5; pointer-events: none; }
.search-panel__field input[type="search"] { width: 100%; padding: 0.8rem 0 0.8rem 2.4rem; background: none; border: none; outline: none; font-family: var(--font-display); font-size: 2.4rem; font-weight: 500; letter-spacing: var(--display-tracking); text-transform: uppercase; }
.search-panel__hint { padding-top: 1.6rem; font-size: var(--text-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: rgb(var(--c-fg-2)); }
.search-panel__results:not(:empty) + .search-panel__hint, .search-panel[data-has-results="true"] .search-panel__hint { display: none; }
.header__brand{gap:1rem}.header__brand-symbol{position:relative;width:3.2rem;height:2rem;overflow:hidden}.header__brand-symbol img{position:absolute;max-width:none;width:9rem;height:9rem;left:-2.88rem;top:-3.48rem}
{% endstylesheet %}

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Un lien avec sous-liens à 2 niveaux devient un méga-menu ; à 1 niveau, un menu déroulant." },
    { "type": "text", "id": "highlight_title", "label": "Lien mis en avant (couleur promotions)", "default": "Sale" },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Contact" },
    { "type": "url", "id": "cta_link", "label": "Bouton — lien" },
    { "type": "header", "content": "Livraison et devise" },
    { "type": "text", "id": "locale_label", "label": "Libellé", "default": "DH / FR" },
    { "type": "text", "id": "locale_title", "label": "Pays", "default": "Maroc" },
    { "type": "textarea", "id": "locale_note", "label": "Note", "default": "Les informations de livraison seront précisées à l’ouverture des commandes." }
  ],
  "blocks": [
    {
      "type": "mega_card",
      "name": "Image du méga-menu",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Titre du lien de menu concerné", "default": "Sneakers" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "New In" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ]
}
{% endschema %}
