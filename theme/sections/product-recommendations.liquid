<section class="related" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="related__head">
      <h2 class="eyebrow">{{ section.settings.heading }}</h2>
    </div>
    <ul class="related__grid">
      {%- for product in recommendations.products -%}
        <li>{% render 'product-card', product: product, layout: 'editorial', section_id: section.id, sizes: '(min-width: 750px) 25vw, 50vw' %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>
<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (el.querySelector('.related__grid')) return;
    fetch(el.dataset.url).then((r) => r.text()).then((html) => {
      const next = new DOMParser().parseFromString(html, 'text/html').querySelector('.related');
      if (next && next.innerHTML.trim()) el.innerHTML = next.innerHTML;
    }).catch(() => {});
  })();
</script>

{% stylesheet %}
.related { padding-block: 6.4rem 8rem; padding-inline: var(--catalog-gutter); border-top: 0.1rem solid rgb(var(--c-border)); }
.related:empty { display: none; }
.related__head { margin-bottom: 2rem; padding-inline: 1.6rem; }
.related__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--catalog-gutter); }
@media (min-width: 750px) { .related__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Recommandations",
  "settings": [ { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" } ]
}
{% endschema %}
