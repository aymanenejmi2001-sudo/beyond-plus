{%- assign collection = collections[section.settings.collection] -%}
<section class="highlights">
  <div class="section-header container">
    <h2 class="section-header__title">{{ section.settings.label }}</h2>
    {%- if collection != blank -%}<a href="{{ collection.url }}" class="section-header__link">{{ 'sections.featured.view_all' | t }}</a>{%- endif -%}
  </div>
  <div class="highlights__wrapper">
    <div class="highlights__feature" data-reveal="frame">
      {%- render 'media-image', image: section.settings.image, fallback: 'beyond-4.jpg', class: 'highlights__image', sizes: '(min-width: 990px) 50vw, 100vw' -%}
      <div class="highlights__info">
        <h3 class="display-1">{{ section.settings.heading }}</h3>
        {%- if section.settings.link_label != blank -%}{% render 'editorial-link', tag: 'span', label: section.settings.link_label, on_image: true %}{%- endif -%}
      </div>
      <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="highlights__link" aria-label="{{ section.settings.heading | escape }}"></a>
    </div>
    <ul class="highlights__products">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: 4 -%}
          <li>{% render 'product-card', product: product, layout: 'overlay', section_id: section.id, sizes: '(min-width: 990px) 25vw, 50vw' %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="highlights__placeholder media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.highlights__wrapper { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
@media (max-width: 989px) { .highlights__wrapper { grid-template-columns: minmax(0, 1fr); } }
.highlights__feature { position: relative; display: flex; align-items: flex-start; overflow: hidden; background-color: rgb(var(--c-bg-2)); min-height: 100%; }
@media (max-width: 989px) { .highlights__feature { aspect-ratio: 4 / 5; } }
.highlights__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: var(--transition-image); }
.highlights__feature:hover .highlights__image { transform: scale(1.02); }
.highlights__info { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 1.6rem; padding: 2.4rem 2rem; color: rgb(255, 255, 255); pointer-events: none; }
.highlights__link { position: absolute; inset: 0; z-index: 2; }
.highlights__products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.highlights__products > li + li { box-shadow: inset 0.1rem 0 0 rgb(var(--c-border)); }
.highlights__placeholder { aspect-ratio: 3 / 4; }
{% endstylesheet %}

{% schema %}
{
  "name": "La sélection",
  "settings": [
    { "type": "text", "id": "label", "label": "Libellé", "default": "La sélection" },
    { "type": "collection", "id": "collection", "label": "Collection (4 produits)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Sneakers" },
    { "type": "text", "id": "link_label", "label": "Lien — texte", "default": "Découvrir la sélection" }
  ],
  "presets": [ { "name": "La sélection" } ]
}
{% endschema %}
