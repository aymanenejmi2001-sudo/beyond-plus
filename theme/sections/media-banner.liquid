<section class="media-banner">
  {%- render 'media-image', image: section.settings.image, fallback: 'beyond-5.jpg', class: 'media-banner__image', sizes: '100vw' -%}
  <span class="media-banner__scrim" aria-hidden="true"></span>
  <div class="media-banner__content">
    <div class="media-banner__headings">
      {%- if section.settings.eyebrow != blank -%}<p class="media-banner__eyebrow" data-reveal="up"><span>{{ section.settings.eyebrow }}</span></p>{%- endif -%}
      <h2 class="display-1" data-reveal="up" style="--reveal-delay: 90ms;"><span>{{ section.settings.heading }}</span></h2>
    </div>
    <div class="media-banner__info" data-reveal="fade" style="--reveal-delay: 220ms;">
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}{% render 'editorial-link', tag: 'span', label: section.settings.link_label, on_image: true %}{%- endif -%}
    </div>
  </div>
  <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="media-banner__link" aria-label="{{ section.settings.heading | escape }}"></a>
</section>

{% stylesheet %}
.media-banner { position: relative; display: flex; min-height: 60rem; height: 51vw; max-height: 82rem; overflow: hidden; background-color: rgb(var(--c-bg-2)); }
@media (max-width: 749px) { .media-banner { height: auto; aspect-ratio: 4 / 5; min-height: 0; } }
.media-banner__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: var(--transition-image); }
.media-banner:hover .media-banner__image { transform: scale(1.02); }
.media-banner__scrim { position: absolute; inset: 0; background-color: rgb(var(--c-overlay)); opacity: var(--overlay-alpha); }
.media-banner__content { position: relative; z-index: 1; display: grid; grid-template-rows: auto 1fr auto; justify-items: center; width: 100%; padding: 2rem 1.2rem; text-align: center; color: rgb(255, 255, 255); }
.media-banner__headings { max-width: 56rem; display: flex; flex-direction: column; gap: 1.6rem; align-items: center; }
.media-banner__eyebrow { font-size: var(--text-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; opacity: 0.85; }
.media-banner__info { grid-row: 3; display: flex; flex-direction: column; align-items: center; gap: 2rem; max-width: 43rem; }
.media-banner__link { position: absolute; inset: 0; z-index: 2; }
{% endstylesheet %}

{% schema %}
{
  "name": "Bannière campagne",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "La campagne" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Hors des lignes." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Du mouvement. Du caractère. Votre propre rythme." },
    { "type": "text", "id": "link_label", "label": "Lien — texte", "default": "Explorer les sneakers" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [ { "name": "Bannière campagne" } ]
}
{% endschema %}
