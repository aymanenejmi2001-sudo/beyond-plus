<div class="page-width page-header">
  <h1 class="page-header__title">{{ 'sections.collections.title' | t }}</h1>
</div>
<ul class="collections-list">
  {%- for collection in collections -%}
    <li>
      <a href="{{ collection.url }}" class="collections-list__item">
        <div class="collections-list__media media">
          {%- assign img = collection.featured_image | default: collection.products.first.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 750px) 33vw, 50vw', alt: collection.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <p class="collections-list__title label">{{ collection.title }}</p>
      </a>
    </li>
  {%- endfor -%}
</ul>

{% stylesheet %}
.collections-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem; padding: 0 0.4rem 8rem; }
@media (min-width: 750px) { .collections-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.collections-list__media { aspect-ratio: 4 / 5; }
.collections-list__title { padding: 1.2rem 0.8rem 2rem; }
{% endstylesheet %}

{% schema %}
{ "name": "Liste des collections", "settings": [] }
{% endschema %}
