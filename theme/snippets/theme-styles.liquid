{%- comment -%}
  Self-hosted fonts and the colour tokens driven by Theme settings → Couleurs.
  Tokens are "r, g, b" triplets so components can apply their own alpha.
{%- endcomment -%}
{%- liquid
  assign bg = settings.color_background
  assign bg2 = settings.color_background_2
  assign fg = settings.color_foreground
  assign fg2 = settings.color_foreground_2
  assign border = settings.color_border
  assign sale = settings.color_sale
-%}
<style>
  @font-face {
    font-family: 'Syne';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url({{ 'syne-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Syne';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url({{ 'syne-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url({{ 'archivo-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Archivo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url({{ 'archivo-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Syne Fallback';
    src: local('Arial');
    ascent-override: 93.93%;
    descent-override: 27.93%;
    line-gap-override: 0%;
    size-adjust: 98.47%;
  }
  @font-face {
    font-family: 'Archivo Fallback';
    src: local('Arial');
    ascent-override: 88.96%;
    descent-override: 21.28%;
    line-gap-override: 0%;
    size-adjust: 98.7%;
  }

  :root {
    --c-bg: {{ bg.red }}, {{ bg.green }}, {{ bg.blue }};
    --c-bg-2: {{ bg2.red }}, {{ bg2.green }}, {{ bg2.blue }};
    --c-fg: {{ fg.red }}, {{ fg.green }}, {{ fg.blue }};
    --c-fg-2: {{ fg2.red }}, {{ fg2.green }}, {{ fg2.blue }};
    --c-border: {{ border.red }}, {{ border.green }}, {{ border.blue }};
    --c-sale: {{ sale.red }}, {{ sale.green }}, {{ sale.blue }};
    --logo-width: {{ settings.logo_width }}px;
  }
</style>
