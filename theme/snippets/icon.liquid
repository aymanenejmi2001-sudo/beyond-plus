{%- comment -%}
  Line icons at 1.3px stroke.
  Usage: {% render 'icon', name: 'close', size: 16 %}
{%- endcomment -%}
{%- assign s = size | default: 16 -%}
{%- case name -%}
  {%- when 'close' -%}
    <svg class="icon icon--close" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'search' -%}
    <svg class="icon icon--search" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><circle cx="7.2" cy="7.2" r="4.7" stroke="currentColor" stroke-width="1.3"/><path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg class="icon icon--menu" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M2 4.5h12M2 11.5h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="icon icon--arrow-left" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M9.5 3L4.5 8l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon icon--arrow-right" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M6.5 3l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon--chevron-down" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.5 6l4.5 4.5L12.5 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg class="icon icon--cart" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M3.1 4.9h9.8l.9 8.1a.5.5 0 0 1-.5.55H2.7a.5.5 0 0 1-.5-.55l.9-8.1Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M5.6 4.9V4a2.4 2.4 0 0 1 4.8 0v.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'arrow-long' -%}
    <svg class="icon editorial-link__arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false"><path d="M0 5h12M8.5 1.2 12.3 5 8.5 8.8" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'arrow-submit' -%}
    <svg class="icon" width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true" focusable="false"><path d="M0 6h15M11 1.5 15.5 6 11 10.5" stroke="currentColor" stroke-width="1.2"/></svg>
  {%- when 'grid-large' -%}
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><rect x="0" y="0" width="7" height="7" fill="currentColor"/><rect x="9" y="0" width="7" height="7" fill="currentColor"/><rect x="0" y="9" width="7" height="7" fill="currentColor"/><rect x="9" y="9" width="7" height="7" fill="currentColor"/></svg>
  {%- when 'grid-dense' -%}
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><rect x="0" y="0" width="4" height="4" fill="currentColor"/><rect x="5.5" y="0" width="4" height="4" fill="currentColor"/><rect x="11" y="0" width="4" height="4" fill="currentColor"/><rect x="0" y="5.5" width="4" height="4" fill="currentColor"/><rect x="5.5" y="5.5" width="4" height="4" fill="currentColor"/><rect x="11" y="5.5" width="4" height="4" fill="currentColor"/><rect x="0" y="11" width="4" height="4" fill="currentColor"/><rect x="5.5" y="11" width="4" height="4" fill="currentColor"/><rect x="11" y="11" width="4" height="4" fill="currentColor"/></svg>
{%- endcase -%}
