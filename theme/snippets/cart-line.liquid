<li class="cart-line" data-line="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-line__thumb media">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '88px', alt: item.product.title }}
    {%- endif -%}
  </a>
  <div class="cart-line__body">
    <div class="cart-line__top">
      <div>
        <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></p>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-line__variant">
            {%- for option in item.options_with_values -%}{{ option.name }} : {{ option.value }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
          </p>
        {%- endunless -%}
      </div>
      <span class="cart-line__price">{{ item.final_line_price | money }}</span>
    </div>
    <div class="cart-line__bottom">
      <div class="stepper">
        <button type="button" data-cart-change="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'sections.cart.decrease' | t }}">−</button>
        <span class="stepper__qty">{{ item.quantity }}</span>
        <button type="button" data-cart-change="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
      </div>
      <button type="button" class="cart-line__remove" data-cart-change="{{ item.key }}" data-quantity="0">{{ 'sections.cart.remove' | t }}</button>
    </div>
  </div>
</li>
